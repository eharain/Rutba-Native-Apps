#!/usr/bin/env bash
# commit-msg hook – blocks AI model / org names in the commit message,
# including Co-authored-by trailers.
#
# Git passes the path to the commit message file as $1.
#
# Install:
#   git config core.hooksPath .githooks
# or copy this file to .git/hooks/commit-msg and make it executable.

set -euo pipefail

COMMIT_MSG_FILE="$1"

# ---------------------------------------------------------------------------
# Blocklist (same as the GitHub Actions workflow – keep in sync)
# ---------------------------------------------------------------------------
COMBINED="openai|chatgpt|gpt-?[0-9]|gpt-?4[o]?|gpt-?3\.?5|openai-o[0-9]|dall-?e|\bwhisper\b|codex|copilot|azure[ -]?openai|anthropic|claude|google[ -]?deepmind|deepmind|gemini|\bbard\b|palm-?2?|lamda|lambda-?ai|\bimagen\b|llama-?[0-9]?|meta[ -]?ai|mistral|mixtral|\bxai\b|\bgrok\b|\bcohere\b|command[ -]?r|stability[ -]?ai|stable[ -]?diffusion|huggingface|hugging[ -]?face|amazon[ -]?bedrock|amazon[ -]?titan|aws[ -]?bedrock|nvidia[ -]?nemo|inflection[ -]?ai|pi[ -]?ai|runway[ -]?ml|midjourney|co-?authored-?by:.*ai|co-?authored-?by:.*bot|co-?authored-?by:.*copilot|co-?authored-?by:.*claude|co-?authored-?by:.*chatgpt|co-?authored-?by:.*gemini|co-?authored-?by:.*gpt|co-?authored-?by:.*llama"

FAILED=0

echo "Checking commit message for AI/model/org names…"
while IFS= read -r line; do
  # Skip comment lines (lines starting with #)
  [[ "$line" =~ ^# ]] && continue
  if echo "$line" | grep -iEq "$COMBINED"; then
    echo "ERROR: Blocked AI/model/org name in commit message: $line"
    FAILED=1
  fi
done < "$COMMIT_MSG_FILE"

if [[ "$FAILED" -eq 1 ]]; then
  echo ""
  echo "Commit rejected. Remove all AI model names, organisation names,"
  echo "and co-author lines that reference AI tools."
  exit 1
fi

echo "✅ No blocked AI/model/org names detected in commit message."
exit 0
