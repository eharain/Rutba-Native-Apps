{
  "name": "rutba-native-apps",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "rutba-native-apps",
      "version": "0.1.0",
      "workspaces": [
        "packages/*",
        "apps/*"
      ],
      "engines": {
        "node": ">=18"
      }
    },
    "apps/mail-desktop": {
      "name": "@rutba/mail-desktop",
      "version": "0.1.0",
      "extraneous": true,
      "dependencies": {
        "@rutba/shell-common": "*"
      }
    },
    "apps/pos-desktop": {
      "name": "@rutba/pos-desktop",
      "version": "0.1.0",
      "extraneous": true,
      "dependencies": {
        "@rutba/shell-common": "*"
      }
    },
    "apps/rutba-mail-desktop": {
      "name": "@rutba/rutba-mail-desktop",
      "version": "0.1.0",
      "dependencies": {
        "@rutba/shell-common": "*"
      }
    },
    "apps/rutba-pos-desktop": {
      "name": "@rutba/rutba-pos-desktop",
      "version": "0.1.0",
      "dependencies": {
        "@rutba/shell-common": "*"
      }
    },
    "apps/rutba-studio-desktop": {
      "name": "@rutba/rutba-studio-desktop",
      "version": "0.1.0",
      "dependencies": {
        "@rutba/shell-common": "*"
      }
    },
    "apps/studio-desktop": {
      "name": "@rutba/studio-desktop",
      "version": "0.1.0",
      "extraneous": true,
      "dependencies": {
        "@rutba/shell-common": "*"
      }
    },
    "node_modules/@rutba/rutba-mail-desktop": {
      "resolved": "apps/rutba-mail-desktop",
      "link": true
    },
    "node_modules/@rutba/rutba-pos-desktop": {
      "resolved": "apps/rutba-pos-desktop",
      "link": true
    },
    "node_modules/@rutba/rutba-studio-desktop": {
      "resolved": "apps/rutba-studio-desktop",
      "link": true
    },
    "node_modules/@rutba/shell-common": {
      "resolved": "packages/shell-common",
      "link": true
    },
    "node_modules/@rutba/sync": {
      "resolved": "packages/sync",
      "link": true
    },
    "packages/shell-common": {
      "name": "@rutba/shell-common",
      "version": "0.1.0",
      "dependencies": {
        "@rutba/sync": "*"
      }
    },
    "packages/sync": {
      "name": "@rutba/sync",
      "version": "0.1.0",
      "engines": {
        "node": ">=18"
      }
    }
  }
}
